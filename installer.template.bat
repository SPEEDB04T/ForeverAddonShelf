<# :
@echo off
setlocal
title Forever Addon Installer
set "FOREVER_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "& ([scriptblock]::Create([IO.File]::ReadAllText($env:FOREVER_SELF)))"
set "RC=%ERRORLEVEL%"
if not defined FOREVER_NOPAUSE pause
exit /b %RC%
#>
# Forever Addon Installer: pick which shelf addons to install or update in WoW Forever.
# The lines above are a batch launcher; everything below runs in Windows PowerShell 5.1+.
# Generated by addon-hub/build.ps1 from installer.template.bat.
# Env overrides for testing: FOREVER_WOW (folder), FOREVER_SELECT ("all" or comma-separated addon names, skips the
# checklist window), FOREVER_NOPAUSE.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

$Addons = @(
__ADDONS__
)
$Flavor = '_forever_'
$ConfigDir = Join-Path $env:LOCALAPPDATA 'ForeverAddons'
$SavedPath = Join-Path $ConfigDir 'wow-path.txt'
$Ua = @{ 'User-Agent' = 'ForeverAddonInstaller' }

function Say([string]$text, [string]$color = 'Gray') { Write-Host $text -ForegroundColor $color }

function Test-Forever([string]$p) {
    return [bool]($p -and (Test-Path -LiteralPath $p -PathType Container) -and ((Split-Path $p -Leaf) -eq $Flavor))
}

# Accepts the World of Warcraft folder, the _forever_ folder, or a folder inside it.
function Resolve-Pick([string]$p) {
    if (-not $p) { return $null }
    $p = $p.TrimEnd('\')
    while ($p) {
        if (Test-Forever $p) { return $p }
        $sub = Join-Path $p $Flavor
        if (Test-Forever $sub) { return $sub }
        $parent = Split-Path $p -Parent
        if ($parent -eq $p) { break }
        $p = $parent
    }
    return $null
}

function Find-Forever {
    if ($env:FOREVER_WOW) { return Resolve-Pick $env:FOREVER_WOW }
    if (Test-Path -LiteralPath $SavedPath) {
        $p = ([IO.File]::ReadAllText($SavedPath)).Trim()
        if (Test-Forever $p) { return $p }
    }
    $candidates = New-Object System.Collections.Generic.List[string]
    foreach ($key in 'HKLM:\SOFTWARE\WOW6432Node\Blizzard Entertainment\World of Warcraft', 'HKLM:\SOFTWARE\Blizzard Entertainment\World of Warcraft') {
        try {
            $ip = (Get-ItemProperty -LiteralPath $key -ErrorAction Stop).InstallPath
            if ($ip) {
                $ip = $ip.TrimEnd('\')
                $candidates.Add((Join-Path (Split-Path $ip -Parent) $Flavor))
                $candidates.Add((Join-Path $ip $Flavor))
            }
        } catch { }
    }
    foreach ($d in [IO.DriveInfo]::GetDrives()) {
        if ($d.DriveType -ne 'Fixed' -or -not $d.IsReady) { continue }
        foreach ($rel in 'World of Warcraft', 'Program Files (x86)\World of Warcraft', 'Program Files\World of Warcraft', 'Games\World of Warcraft', 'Blizzard\World of Warcraft') {
            $candidates.Add((Join-Path (Join-Path $d.RootDirectory.FullName $rel) $Flavor))
        }
    }
    foreach ($p in $candidates) { if (Test-Forever $p) { return $p } }
    return $null
}

function Select-Forever {
    Add-Type -AssemblyName System.Windows.Forms
    $dlg = New-Object System.Windows.Forms.FolderBrowserDialog
    $dlg.Description = 'Pick your World of Warcraft folder (the one with _forever_ inside it).'
    $dlg.ShowNewFolderButton = $false
    $owner = New-Object System.Windows.Forms.Form
    $owner.TopMost = $true
    try {
        if ($dlg.ShowDialog($owner) -eq [System.Windows.Forms.DialogResult]::OK) { return Resolve-Pick $dlg.SelectedPath }
    } finally { $owner.Dispose() }
    return $null
}

function Get-InstalledVersion([string]$addonsDir, [string]$name) {
    $toc = Join-Path (Join-Path $addonsDir $name) "$name.toc"
    if (-not (Test-Path -LiteralPath $toc)) { return $null }
    foreach ($line in [IO.File]::ReadAllLines($toc)) {
        if ($line -match '^##\s*Version:\s*(.+)$') { return $Matches[1].Trim() }
    }
    return '?'
}

# The checklist window. Returns the ticked addons, or $null if the window was closed or cancelled.
function Select-Addons($items) {
    Add-Type -AssemblyName System.Windows.Forms, System.Drawing
    [System.Windows.Forms.Application]::EnableVisualStyles()
    $form = New-Object System.Windows.Forms.Form
    $form.Text = 'Forever Addon Installer'
    $form.StartPosition = 'CenterScreen'
    $form.TopMost = $true
    $form.Font = New-Object System.Drawing.Font('Segoe UI', 9)
    $form.ClientSize = New-Object System.Drawing.Size(760, 340)
    $form.MinimumSize = New-Object System.Drawing.Size(560, 260)

    $list = New-Object System.Windows.Forms.ListView
    $list.View = 'Details'
    $list.CheckBoxes = $true
    $list.FullRowSelect = $true
    $list.Dock = 'Fill'
    [void]$list.Columns.Add('Addon', 170)
    [void]$list.Columns.Add('You have', 80)
    [void]$list.Columns.Add('Latest', 80)
    [void]$list.Columns.Add('What it does', 400)
    foreach ($it in $items) {
        $li = New-Object System.Windows.Forms.ListViewItem($it.Title)
        [void]$li.SubItems.Add($(if ($it.Installed) { $it.Installed } else { '-' }))
        [void]$li.SubItems.Add($(if ($it.Latest) { $it.Latest } else { 'offline' }))
        [void]$li.SubItems.Add($it.Notes)
        $li.Checked = $it.Checked
        $li.Tag = $it
        if (-not $it.Latest) { $li.ForeColor = [System.Drawing.Color]::Gray }
        [void]$list.Items.Add($li)
    }

    $label = New-Object System.Windows.Forms.Label
    $label.Text = 'Tick the addons you want. Ticked ones are installed or updated to the latest version; unticked ones are left as they are.'
    $label.Dock = 'Top'
    $label.Height = 40
    $label.Padding = New-Object System.Windows.Forms.Padding(10, 10, 10, 0)

    $buttons = New-Object System.Windows.Forms.FlowLayoutPanel
    $buttons.Dock = 'Bottom'
    $buttons.FlowDirection = 'RightToLeft'
    $buttons.Height = 48
    $buttons.Padding = New-Object System.Windows.Forms.Padding(8)
    $cancel = New-Object System.Windows.Forms.Button
    $cancel.Text = 'Cancel'
    $cancel.Width = 90
    $cancel.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
    $ok = New-Object System.Windows.Forms.Button
    $ok.Text = 'Install'
    $ok.Width = 110
    $ok.DialogResult = [System.Windows.Forms.DialogResult]::OK
    $buttons.Controls.AddRange(@($cancel, $ok))
    $form.AcceptButton = $ok
    $form.CancelButton = $cancel

    # Fill first, then the docked edges, so the list takes the space left between them.
    $form.Controls.Add($list)
    $form.Controls.Add($label)
    $form.Controls.Add($buttons)

    try {
        if ($form.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { return $null }
        return @($list.CheckedItems | ForEach-Object { $_.Tag })
    } finally { $form.Dispose() }
}

Say ''
Say 'Forever Addon Installer' 'Cyan'
Say ''

$wow = Find-Forever
if (-not $wow) {
    Say "Couldn't find WoW Forever by itself. Pick your World of Warcraft folder in the window that opens." 'Yellow'
    $wow = Select-Forever
}
if (-not $wow) {
    Say "That folder has no $Flavor folder in it, so nothing was installed. Run this again and pick the World of Warcraft folder." 'Red'
    exit 1
}
New-Item -ItemType Directory -Force $ConfigDir | Out-Null
[IO.File]::WriteAllText($SavedPath, $wow)
$addonsDir = Join-Path $wow 'Interface\AddOns'
New-Item -ItemType Directory -Force $addonsDir | Out-Null
Say "WoW Forever folder: $wow"
Say 'Checking for the latest versions...'

$items = @()
foreach ($a in $Addons) {
    $item = [pscustomobject]@{
        Name = $a.Name; Title = $a.Title; Notes = $a.Notes; Repo = $a.Repo
        Installed = (Get-InstalledVersion $addonsDir $a.Name); Latest = $null; Asset = $null; Checked = $false
    }
    try {
        $release = Invoke-RestMethod -Uri "https://api.github.com/repos/$($a.Repo)/releases/latest" -Headers $Ua -UseBasicParsing
        $item.Asset = @($release.assets | Where-Object { $_.name -like '*.zip' })[0]
        if ($item.Asset) { $item.Latest = ($release.tag_name -replace '^v', '') }
    } catch { }
    $items += $item
}
# Pre-tick what you already have (so updating is one click); on a first run with nothing installed, tick everything.
$haveAny = @($items | Where-Object { $_.Installed }).Count -gt 0
foreach ($it in $items) { $it.Checked = [bool]($it.Latest -and ($it.Installed -or -not $haveAny)) }

if ($env:FOREVER_SELECT) {
    $want = @($env:FOREVER_SELECT -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    $chosen = @($items | Where-Object { $want -contains 'all' -or $want -contains $_.Name })
} else {
    $chosen = Select-Addons $items
    if ($null -eq $chosen) { Say ''; Say 'Cancelled. Nothing was changed.' 'Yellow'; exit 0 }
}
if (-not $chosen.Count) { Say ''; Say 'Nothing ticked, so nothing was changed.' 'Yellow'; exit 0 }

Say ''
$tmp = Join-Path $env:TEMP ('ForeverAddons-' + [guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory $tmp | Out-Null
$failed = 0
try {
    foreach ($it in $chosen) {
        try {
            if (-not $it.Asset) { throw "couldn't reach GitHub to get it." }
            $zip = Join-Path $tmp $it.Asset.name
            Invoke-WebRequest -Uri $it.Asset.browser_download_url -OutFile $zip -Headers $Ua -UseBasicParsing
            $out = Join-Path $tmp ([IO.Path]::GetFileNameWithoutExtension($it.Asset.name))
            Expand-Archive -LiteralPath $zip -DestinationPath $out -Force
            $folders = @(Get-ChildItem -LiteralPath $out -Directory)
            if (-not $folders) { throw 'the zip has no addon folder in it.' }
            foreach ($f in $folders) {
                $dest = Join-Path $addonsDir $f.Name
                if (Test-Path -LiteralPath $dest) { Remove-Item -LiteralPath $dest -Recurse -Force }
                Copy-Item -LiteralPath $f.FullName -Destination $addonsDir -Recurse -Force
            }
            $was = $(if ($it.Installed -and $it.Installed -ne $it.Latest) { " (was $($it.Installed))" } elseif ($it.Installed) { ' (reinstalled)' } else { '' })
            Say "  Installed $($it.Title) $($it.Latest)$was" 'Green'
        } catch {
            $failed++
            Say "  $($it.Title) didn't install: $($_.Exception.Message)" 'Red'
        }
    }
} finally {
    Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
}

Say ''
if ($failed) {
    Say "$failed addon(s) didn't install. Check your internet connection and run this again." 'Red'
    exit 1
}
Say 'Done. Start WoW (or type /reload if it is already open) and tick the addons in the AddOns list.' 'Cyan'
Say 'Run this installer again any time to update or add more.'
exit 0
