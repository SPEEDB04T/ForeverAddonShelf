$RowXaml = @'
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
  <Border CornerRadius="3" Opacity="0" IsHitTestVisible="False">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A4C8CE6" Offset="0"/>
        <GradientStop Color="#664C8CE6" Offset="0.5"/>
        <GradientStop Color="#1A4C8CE6" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.OpacityMask>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#40000000" Offset="0"/>
        <GradientStop Color="#FF000000" Offset="0.25"/>
        <GradientStop Color="#FF000000" Offset="0.75"/>
        <GradientStop Color="#40000000" Offset="1"/>
      </LinearGradientBrush>
    </Border.OpacityMask>
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
            <DataTrigger.EnterActions>
              <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"/></Storyboard></BeginStoryboard>
            </DataTrigger.EnterActions>
            <DataTrigger.ExitActions>
              <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard>
            </DataTrigger.ExitActions>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
  </Border>
  <Grid x:Name="Inner" Margin="10,10,14,10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid x:Name="Box" Width="26" Height="26" VerticalAlignment="Center">
      <Border CornerRadius="4" Background="#000000"/>
      <Border Margin="1" CornerRadius="3.5" Background="{DynamicResource Metal}"/>
      <Border Margin="3" CornerRadius="2" Background="#0B0907"/>
      <Border Margin="3" CornerRadius="2" BorderThickness="1" BorderBrush="#C0000000"/>
      <Grid x:Name="Tick" Opacity="0" Margin="-1,-5,-6,0">
        <Path Data="M7,17 L13,25 L29,5" Stroke="#000000" StrokeThickness="6.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <Path Data="M7,17 L13,25 L29,5" Stroke="{DynamicResource Gold}" StrokeThickness="3.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
      <Grid>
        <TextBlock x:Name="NameShadow" FontFamily="{DynamicResource Friz}" FontWeight="Bold" FontSize="15.5" Foreground="#000000" Margin="1,1,-1,-1" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Name" FontFamily="{DynamicResource Friz}" FontWeight="Bold" FontSize="15.5" Foreground="#FFD100" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <TextBlock x:Name="Notes" Foreground="#D4D4D4" TextWrapping="Wrap" LineHeight="17" LineStackingStrategy="BlockLineHeight" Margin="0,3,0,0"/>
    </StackPanel>
    <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="72">
      <TextBlock x:Name="StatusShadow" Foreground="#000000" Margin="1,1,-1,-1" HorizontalAlignment="Right"/>
      <TextBlock x:Name="Status" HorizontalAlignment="Right"/>
    </Grid>
  </Grid>
</Grid>
'@

# The soft shadow under the panel is a stack of faint rings: it costs nothing to draw, unlike a blur.
$WindowXaml = $WindowXaml.Replace('<!--SHADOW-->', (-join (0..21 | ForEach-Object {
    $m = 22 - $_
    '<Border Margin="-{0},{1},-{0},-{2}" CornerRadius="{3}" BorderThickness="{4}" BorderBrush="#{5:X2}000000"/>' -f $m, (5 - $m), ($m + 5), ($m + 12), ($m + 12), [int][Math]::Round(255 * (0.006 + 0.0034 * $_))
})))

# Start talking to GitHub before the window is even built: by the time it paints, the answer is usually in.
$S = @{
    Wow = (Find-Forever); Items = @(); ByName = @{}; Rows = @{}; Phase = 'loading'; Current = ''; Work = $null; After = $null
    Touched = $false; Closing = $false; Fresh = $false; IconSet = $false; Shared = [hashtable]::Synchronized(@{})
}
if ($S.Wow) { Save-WowPath $S.Wow }
$S.Items = @(Get-KnownShelf)
$S.Work = Start-Work $RefreshScript @{ Known = $S.Items; Wow = $S.Wow; Shared = $S.Shared; WindowXaml = $WindowXaml; RowXaml = $RowXaml }
Add-Timing 'refresh started'
foreach ($it in $S.Items) { Update-Status $it $S.Wow }

Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase, System.Xaml
# Drawn on the processor: for a window this small that is as smooth as the graphics card, and it opens much sooner.
[System.Windows.Media.RenderOptions]::ProcessRenderMode = [System.Windows.Interop.RenderMode]::SoftwareOnly
Add-Timing 'wpf loaded'

$Ellipsis = [string][char]0x2026
$Gold = '#FFD100'; $White = '#FFFFFF'; $Grey = '#808080'; $Green = '#19FF19'; $Red = '#FF1919'; $Orange = '#FF8040'
$StatusColors = @{
    'Not installed' = '#C8C8C8'; 'Update available' = $Orange; 'Up to date' = $Green
    'Unavailable' = $Grey; 'Failed' = $Red; 'Installing' = $Gold; 'Queued' = '#C8C8C8'; '' = $Grey
}
$BrushCache = @{}
function Get-Brush([string]$hex) {
    if (-not $BrushCache.ContainsKey($hex)) {
        $b = New-Object System.Windows.Media.SolidColorBrush -ArgumentList ([System.Windows.Media.ColorConverter]::ConvertFromString($hex))
        $b.Freeze()
        $BrushCache[$hex] = $b
    }
    return $BrushCache[$hex]
}

function Start-Fade($element, [double]$to, [int]$ms) {
    $a = New-Object System.Windows.Media.Animation.DoubleAnimation
    $a.To = $to
    $a.Duration = [System.Windows.Duration][TimeSpan]::FromMilliseconds($ms)
    $element.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $a)
}

function Start-Glide($bar, [double]$to, [int]$ms) {
    $a = New-Object System.Windows.Media.Animation.DoubleAnimation
    $a.To = $to
    $a.Duration = [System.Windows.Duration][TimeSpan]::FromMilliseconds($ms)
    $bar.BeginAnimation([System.Windows.Controls.Primitives.RangeBase]::ValueProperty, $a)
}

# Runs something a moment later without blocking the window.
function Start-Later([int]$ms, [scriptblock]$do) {
    $t = New-Object System.Windows.Threading.DispatcherTimer
    $t.Interval = [TimeSpan]::FromMilliseconds($ms)
    $t.Tag = $do
    $t.Add_Tick({
        param($sender, $e)
        $sender.Stop()
        try { & ([scriptblock]$sender.Tag) } catch { Show-Error $_.Exception.Message }
    })
    $t.Start()
}

# ---- drawing

function Set-Status([string]$text, [string]$color) {
    $StatusText.Text = $text; $StatusShadow.Text = $text
    $StatusText.Foreground = Get-Brush $(if ($color) { $color } else { $White })
    Show-Footer
}

function Show-Row($it) {
    $ui = $S.Rows[$it.Name]
    if (-not $ui) { return }
    $on = [bool]$it.Want
    if ($ui.On -ne $on) { $ui.On = $on; Start-Fade $ui.Tick $(if ($on) { 1.0 } else { 0.0 }) 70 }
    $ui.Name.Text = $it.Title; $ui.NameShadow.Text = $it.Title; $ui.TipTitle.Text = $it.Title
    $ui.Notes.Text = $it.Notes; $ui.TipNotes.Text = $it.Notes
    $vis = $(if ($it.Notes) { 'Visible' } else { 'Collapsed' })
    $ui.Notes.Visibility = $vis; $ui.TipNotes.Visibility = $vis
    # Greyed out only once GitHub has said there is nothing to download.
    $dead = (-not $it.Latest -and $S.Fresh)
    $ui.Name.Foreground = Get-Brush $(if ($dead) { $Grey } else { $Gold })
    $ui.Notes.Opacity = $(if ($dead) { 0.55 } else { 1.0 })
    $busy = ($S.Phase -eq 'installing' -or $S.Phase -eq 'finishing')
    $ui.Box.Opacity = $(if ($busy) { 0.45 } else { 1.0 })
    # While installing: the one in flight, then the ones still waiting their turn.
    $order = @($(if ($S.Phase -eq 'installing') { $S.Todo | ForEach-Object { $_.Name } }))
    $turn = [array]::IndexOf($order, $it.Name)
    $now = $(if ($S.Current) { [array]::IndexOf($order, $S.Current) } else { -1 })
    $state = $(if ($turn -ge 0 -and $turn -eq $now) { 'Installing' } elseif ($turn -gt $now) { 'Queued' } elseif (-not $it.Latest -and -not $S.Fresh) { '' } else { $it.Status })
    $text = switch ($state) {
        'Update available' { "Update $($it.Latest)" }
        'Installing' { "Installing$Ellipsis" }
        default { $state }
    }
    $ui.Status.Text = $text; $ui.StatusShadow.Text = $text
    $ui.Status.Foreground = Get-Brush $StatusColors[$state]
    $tip = $(if ($state -eq 'Failed') { "It didn't install: $($it.Error)" } elseif ($it.Installed -and $it.Latest -and $it.Installed -ne $it.Latest) { "You have $($it.Installed). The latest is $($it.Latest)." } elseif ($it.Latest) { "Version $($it.Latest)" } else { '' })
    $ui.TipVersion.Text = $tip
    $ui.TipVersion.Visibility = $(if ($tip) { 'Visible' } else { 'Collapsed' })
}

function Add-Row($it) {
    $row = [Windows.Markup.XamlReader]::Parse($RowXaml)
    $ui = @{ Row = $row; On = $false }
    foreach ($n in 'Inner', 'Box', 'Tick', 'Name', 'NameShadow', 'Notes', 'Status', 'StatusShadow') { $ui[$n] = $row.FindName($n) }
    # The hover card, like the game's own: the name in gold, then what it does.
    $tip = New-Object System.Windows.Controls.StackPanel
    $ui.TipTitle = New-Object System.Windows.Controls.TextBlock
    $ui.TipTitle.FontFamily = $window.FindResource('Friz'); $ui.TipTitle.FontWeight = 'Bold'; $ui.TipTitle.FontSize = 15.5
    $ui.TipTitle.Foreground = Get-Brush $Gold
    $ui.TipNotes = New-Object System.Windows.Controls.TextBlock
    $ui.TipNotes.TextWrapping = 'Wrap'; $ui.TipNotes.Margin = '0,4,0,0'
    $ui.TipVersion = New-Object System.Windows.Controls.TextBlock
    $ui.TipVersion.TextWrapping = 'Wrap'; $ui.TipVersion.Margin = '0,6,0,0'; $ui.TipVersion.Foreground = Get-Brush '#A0A0A0'
    foreach ($t in $ui.TipTitle, $ui.TipNotes, $ui.TipVersion) { [void]$tip.Children.Add($t) }
    $row.ToolTip = $tip
    $row.Tag = $it.Name
    $row.Add_MouseLeftButtonDown({
        param($sender, $e)
        $hit = $S.ByName[[string]$sender.Tag]
        if ($S.Phase -eq 'installing' -or $S.Phase -eq 'finishing' -or -not $hit -or -not $hit.Latest) { return }
        $hit.Want = -not $hit.Want
        $S.Touched = $true
        Show-Row $hit
        Set-Status '' $null
    })
    $S.Rows[$it.Name] = $ui
    [void]$RowsPanel.Children.Add($row)
}

function Show-Rows {
    $RowsPanel.Children.Clear(); $S.Rows = @{}; $S.ByName = @{}
    foreach ($it in $S.Items) { $S.ByName[$it.Name] = $it; Add-Row $it; Show-Row $it }
    Set-RowFit
}

# ---- a shelf that keeps growing
# Rows are roomy while every addon fits on the screen. Past that they go compact (one line of description; the
# hover card still has all of it), and only when even those don't fit does the list scroll.
function Set-RowFit {
    if (-not $S.Rows.Count) { return }
    $max = $(if ($S.ListMax) { $S.ListMax } else { $RowsScroll.MaxHeight })
    $room = New-Object System.Windows.Size -ArgumentList 520, ([double]::PositiveInfinity)   # 520: the list's width inside the window
    foreach ($compact in $false, $true) {
        foreach ($ui in $S.Rows.Values) {
            $ui.Notes.TextWrapping = $(if ($compact) { 'NoWrap' } else { 'Wrap' })
            $ui.Notes.TextTrimming = $(if ($compact) { 'CharacterEllipsis' } else { 'None' })
            $ui.Inner.Margin = $(if ($compact) { '10,6,14,6' } else { '10,10,14,10' })
            # Measuring the list again only looks at parts marked as changed, so mark the whole way up from the text.
            $e = $ui.Notes
            while ($e -and $e -ne $RowsPanel) { $e.InvalidateMeasure(); $e = $e.Parent }
        }
        $S.Compact = $compact
        $RowsPanel.InvalidateMeasure()
        $RowsPanel.Measure($room)
        if ($RowsPanel.DesiredSize.Height -le $max) { break }
    }
    # A list that has to scroll ends 28 px into a row: the rows in view are whole, and the cut one is under the arrow's dark edge.
    $fit = $max
    if ($RowsPanel.DesiredSize.Height -gt $max) {
        $row = $RowsPanel.Children[0].DesiredSize.Height
        if ($row -gt 0 -and $max -gt $row + 28) { $fit = [Math]::Floor(($max - 28) / $row) * $row + 28 }
    }
    $RowsScroll.MaxHeight = $fit
}

# The dark edge with an arrow, at the top or bottom of the list, says there is more that way.
function Show-ScrollHints {
    $up = $RowsScroll.VerticalOffset -gt 1
    $down = $RowsScroll.VerticalOffset -lt $RowsScroll.ScrollableHeight - 1
    if ($S.HintUp -ne $up) { $S.HintUp = $up; Start-Fade $MoreAbove $(if ($up) { 1.0 } else { 0.0 }) 120 }
    if ($S.HintDown -ne $down) { $S.HintDown = $down; Start-Fade $MoreBelow $(if ($down) { 1.0 } else { 0.0 }) 120 }
}

function Start-Scroll([double]$to) {
    $S.ScrollFrom = $RowsScroll.VerticalOffset
    $S.ScrollTo = [Math]::Max(0, [Math]::Min($RowsScroll.ScrollableHeight, $to))
    $S.ScrollStep = 0
    if (-not $S.ScrollTimer) {
        $S.ScrollTimer = New-Object System.Windows.Threading.DispatcherTimer
        $S.ScrollTimer.Interval = [TimeSpan]::FromMilliseconds(15)
        $S.ScrollTimer.Add_Tick({
            $S.ScrollStep = $S.ScrollStep + 1
            $t = [Math]::Min(1.0, $S.ScrollStep / 12.0)
            $RowsScroll.ScrollToVerticalOffset($S.ScrollFrom + ($S.ScrollTo - $S.ScrollFrom) * (1 - [Math]::Pow(1 - $t, 3)))
            if ($t -ge 1) { $S.ScrollTimer.Stop() }
        })
    }
    $S.ScrollTimer.Start()
}

# Glides a scrolling list so a row sits in the middle of it: the one being installed, or one that failed.
function Show-RowInView([string]$name) {
    $ui = $S.Rows[$name]
    if (-not $ui -or $RowsScroll.ScrollableHeight -le 0) { return }
    $y = $ui.Row.TranslatePoint((New-Object System.Windows.Point -ArgumentList 0, 0), $RowsPanel).Y
    Start-Scroll ($y - ($RowsScroll.ViewportHeight - $ui.Row.ActualHeight) / 2)
}

# The usable part of the screen the window is on (before it is shown: the screen with the mouse, which is where it
# opens), top and height in the window's own units. A second screen can be a different size from the main one.
function Get-ScreenArea {
    $sp = [System.Windows.SystemParameters]
    if ($env:FOREVER_SNAPSHOT) {
        $h = 0.0
        [void][double]::TryParse([string]$env:FOREVER_SCREEN, [ref]$h)
        return @{ Top = -30000.0; Height = $(if ($h -gt 0) { $h } else { $sp::WorkArea.Height }) }
    }
    $area = @{ Top = $sp::WorkArea.Top; Height = $sp::WorkArea.Height }
    try {
        if ($sp::VirtualScreenWidth -gt $sp::PrimaryScreenWidth + 1 -or $sp::VirtualScreenHeight -gt $sp::PrimaryScreenHeight + 1) {
            Add-Type -AssemblyName System.Windows.Forms
            $scale = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds.Height / $sp::PrimaryScreenHeight
            $screen = $(if ($S.Shown) { [System.Windows.Forms.Screen]::FromHandle((New-Object System.Windows.Interop.WindowInteropHelper -ArgumentList $window).Handle) }
                else { [System.Windows.Forms.Screen]::FromPoint([System.Windows.Forms.Cursor]::Position) })
            if ($scale -gt 0) { $area = @{ Top = $screen.WorkingArea.Top / $scale; Height = $screen.WorkingArea.Height / $scale } }
        }
    } catch { }
    return $area
}

# The window gets taller when the fresh list has more addons than the remembered one: it must not run off the screen.
function Set-OnScreen {
    if (-not $S.Shown) { return }
    try {
        $a = Get-ScreenArea
        $bottom = $a.Top + $a.Height
        if ($window.Top + $window.ActualHeight -gt $bottom + 0.5) { $window.Top = $a.Top + [Math]::Max(0, ($a.Height - $window.ActualHeight) / 2) }
    } catch { }
}

function Show-Footer {
    $n = @($S.Items | Where-Object { $_.Want }).Count
    $Go.Content = $(if ($n -gt 1) { "Install ($n)" } else { 'Install' })
    $busy = ($S.Phase -eq 'installing' -or $S.Phase -eq 'finishing')
    $Go.IsEnabled = ($S.Phase -eq 'ready') -and $n -gt 0 -and [bool]$S.Wow
    $CloseButton2.IsEnabled = -not $busy
    $CloseX.IsEnabled = -not $busy
    $ChangeButton.IsEnabled = -not $busy
    $hasStatus = [bool]$StatusText.Text
    $Cast.Visibility = $(if ($busy) { 'Visible' } else { 'Collapsed' })
    $StatusRow.Visibility = $(if (-not $busy -and $hasStatus) { 'Visible' } else { 'Collapsed' })
    $ShortcutRow.Visibility = $(if (-not $busy -and -not $hasStatus -and $S.OfferShortcut -and $n -gt 0) { 'Visible' } else { 'Collapsed' })
    $AutoRow.Visibility = $(if (-not $busy -and -not $hasStatus -and $S.Wow) { 'Visible' } else { 'Collapsed' })
    if ($S.ShortOn -ne $S.WantShortcut) { $S.ShortOn = $S.WantShortcut; Start-Fade $ShortTick $(if ($S.WantShortcut) { 1.0 } else { 0.0 }) 70 }
    if ($S.AutoOn -ne $S.WantAuto) { $S.AutoOn = $S.WantAuto; Start-Fade $AutoTick $(if ($S.WantAuto) { 1.0 } else { 0.0 }) 70 }
}

# Sets the scheduled task up or takes it away, on a thread of its own so the window doesn't wait for it.
# A test run never touches the computer's scheduled tasks.
function Save-AutoUpdate([bool]$on) {
    if ($env:FOREVER_SNAPSHOT) { return }
    [void](Start-Work 'Set-AutoUpdate $On $Self' @{ On = $on; Self = $env:FOREVER_SELF })
}

function Show-Folder {
    if ($S.Wow) {
        # Long paths keep their end (the part that says which install it is), not their start.
        $shown = $S.Wow
        if ($shown.Length -gt 62) {
            $cut = $shown.Substring($shown.Length - 58)
            $slash = $cut.IndexOf('\')
            if ($slash -ge 0 -and $slash -lt 30) { $cut = $cut.Substring($slash) }
            $shown = $Ellipsis + $cut
        }
        $FolderText.Text = $shown; $FolderShadow.Text = $shown
        $FolderText.Foreground = Get-Brush $White
        $FolderText.ToolTip = $(if ($shown -ne $S.Wow) { $S.Wow } else { $null })
        $ChangeButton.Content = 'Change'
    } else {
        $FolderText.Text = 'WoW Forever not found'; $FolderShadow.Text = 'WoW Forever not found'
        $FolderText.Foreground = Get-Brush $Red
        $FolderText.ToolTip = $null
        $ChangeButton.Content = 'Browse'
    }
}

function Set-Wants {
    $haveAny = @($S.Items | Where-Object { $_.Installed }).Count -gt 0
    foreach ($it in $S.Items) { $it.Want = [bool]($it.Latest -and ($it.Status -eq 'Update available' -or -not $haveAny)) }
}

function Show-Idle {
    foreach ($it in $S.Items) { Show-Row $it }
    $n = @($S.Items | Where-Object { $_.Want }).Count
    if (-not $S.Wow) { Set-Status 'Choose your World of Warcraft folder.' $Gold }
    elseif ($S.Phase -eq 'ready' -and -not $S.Fresh) { Set-Status "Can't reach GitHub. Check your connection." $Red }
    # With updates on, the tick says it instead (each row already says "Up to date").
    elseif ($S.Phase -eq 'ready' -and $n -eq 0 -and -not $S.Touched -and -not $S.WantAuto) { Set-Status 'Everything is up to date.' $Green }
    else { Set-Status '' $null }
}

# A modern folder picker (the Explorer-style one); falls back to the classic tree if it can't be built.
function Select-Folder([string]$start) {
    $title = 'Pick your World of Warcraft folder'
    try {
        if (-not ('Forever.FolderPicker' -as [type])) {
            Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
namespace Forever {
    [ComImport, Guid("DC1C5A9C-E88A-4dde-A5A1-60F82A20AEF7")] class FileOpenDialogRCW { }
    [ComImport, Guid("42f85136-db7e-439c-85f1-e4075d135fc8"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IFileDialog {
        [PreserveSig] int Show(IntPtr hwnd);
        void SetFileTypes(uint c, IntPtr f); void SetFileTypeIndex(uint i); void GetFileTypeIndex(out uint i);
        void Advise(IntPtr e, out uint cookie); void Unadvise(uint cookie);
        void SetOptions(uint fos); void GetOptions(out uint fos);
        void SetDefaultFolder(IShellItem psi); void SetFolder(IShellItem psi); void GetFolder(out IShellItem ppsi); void GetCurrentSelection(out IShellItem ppsi);
        void SetFileName([MarshalAs(UnmanagedType.LPWStr)] string n); void GetFileName([MarshalAs(UnmanagedType.LPWStr)] out string n);
        void SetTitle([MarshalAs(UnmanagedType.LPWStr)] string t); void SetOkButtonLabel([MarshalAs(UnmanagedType.LPWStr)] string t); void SetFileNameLabel([MarshalAs(UnmanagedType.LPWStr)] string t);
        void GetResult(out IShellItem ppsi);
    }
    [ComImport, Guid("43826D1E-E718-42EE-BC55-A1E261C37BFE"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IShellItem {
        void BindToHandler(IntPtr pbc, ref Guid bhid, ref Guid riid, out IntPtr ppv);
        void GetParent(out IShellItem ppsi);
        void GetDisplayName(uint sigdn, [MarshalAs(UnmanagedType.LPWStr)] out string name);
    }
    public static class FolderPicker {
        [DllImport("shell32.dll", CharSet = CharSet.Unicode, PreserveSig = false)]
        static extern void SHCreateItemFromParsingName(string path, IntPtr pbc, [MarshalAs(UnmanagedType.LPStruct)] Guid riid, out IShellItem item);
        public static string Pick(IntPtr owner, string title, string start) {
            IFileDialog d = (IFileDialog)new FileOpenDialogRCW();
            uint o; d.GetOptions(out o); d.SetOptions(o | 0x20 | 0x40);
            d.SetTitle(title);
            if (!String.IsNullOrEmpty(start)) {
                try { IShellItem si; SHCreateItemFromParsingName(start, IntPtr.Zero, typeof(IShellItem).GUID, out si); d.SetFolder(si); } catch { }
            }
            if (d.Show(owner) != 0) return null;
            IShellItem r; d.GetResult(out r);
            string p; r.GetDisplayName(0x80058000, out p);
            return p;
        }
    }
}
'@
        }
        $owner = (New-Object System.Windows.Interop.WindowInteropHelper($window)).Handle
        return [Forever.FolderPicker]::Pick($owner, $title, $start)
    } catch {
        Add-Type -AssemblyName System.Windows.Forms
        $dlg = New-Object System.Windows.Forms.FolderBrowserDialog
        $dlg.Description = "$title (the one with $Flavor inside it)."
        $dlg.ShowNewFolderButton = $false
        if ($start) { $dlg.SelectedPath = $start }
        if ($dlg.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { return $null }
        return $dlg.SelectedPath
    }
}

# Test hook: draws the window to a PNG at twice its size, without it ever being on the desktop.
function Save-Snapshot([string]$name) {
    $k = 2.0
    $rtb = New-Object System.Windows.Media.Imaging.RenderTargetBitmap -ArgumentList ([int]($window.ActualWidth * $k)), ([int]($window.ActualHeight * $k)), (96 * $k), (96 * $k), ([System.Windows.Media.PixelFormats]::Pbgra32)
    # A plain grey backdrop, so the shadow and the corners can be judged.
    $dv = New-Object System.Windows.Media.DrawingVisual
    $dc = $dv.RenderOpen()
    $dc.DrawRectangle((Get-Brush '#3A3F4A'), $null, (New-Object System.Windows.Rect -ArgumentList 0, 0, $window.ActualWidth, $window.ActualHeight))
    $dc.Close()
    $rtb.Render($dv)
    $rtb.Render($window.Content)
    $enc = New-Object System.Windows.Media.Imaging.PngBitmapEncoder
    $enc.Frames.Add([System.Windows.Media.Imaging.BitmapFrame]::Create($rtb))
    $fs = [IO.File]::Create((Join-Path $env:FOREVER_SNAPSHOT $name))
    try { $enc.Save($fs) } finally { $fs.Close() }
}

function Get-Spark {
    [void]$Bar.ApplyTemplate()
    return $Bar.Template.FindName('Spark', $Bar)
}

# ---- the steps

# The background refresh came back: adopt its list, keep anything the person already ticked.
function Complete-Refresh($result, [string]$err) {
    $new = @($result | Where-Object { $_ })
    $S.Phase = 'ready'
    if ($new.Count) {
        $sameRows = (@($new | ForEach-Object { $_.Name }) -join '|') -eq (@($S.Items | ForEach-Object { $_.Name }) -join '|')
        $S.Items = $new
        $S.Fresh = @($new | Where-Object { $_.Fresh }).Count -gt 0
    } else { $sameRows = $true }
    foreach ($it in $S.Items) { Update-Status $it $S.Wow }
    if ($S.Touched) { foreach ($it in $S.Items) { if (-not $it.Latest) { $it.Want = $false } } } else { Set-Wants }
    if ($sameRows) { foreach ($it in $S.Items) { $S.ByName[$it.Name] = $it } } else { Show-Rows }
    Show-Idle
    Set-RowFit      # the fresh descriptions may be longer or shorter than the remembered ones
    Add-Timing 'versions checked' -Save
    if ($env:FOREVER_SELF -and [string]::Equals($env:FOREVER_SELF, $LocalCopy, [StringComparison]::OrdinalIgnoreCase)) { [void](Start-Work 'Update-LocalCopy' @{}) }
    if ($env:FOREVER_SNAPSHOT) {
        Start-Later 500 {
            [IO.File]::WriteAllLines((Join-Path $env:FOREVER_SNAPSHOT 'layout.txt'), @(
                "rows $($S.Items.Count)", "compact $($S.Compact)", "scroll $([int]$RowsScroll.ScrollableHeight)",
                "list $([int]$RowsScroll.ActualHeight)", "window $([int]$window.ActualHeight)",
                "top $([int]($window.Top - $S.Area.Top))", "screen $([int]$S.Area.Height)",
                "hints $($MoreAbove.Opacity) $($MoreBelow.Opacity)",
                "room $([int]$S.ListMax) rows-need $([int]$RowsPanel.DesiredSize.Height) row $($RowsPanel.Children[0].DesiredSize.Height) list-max $($RowsScroll.MaxHeight)"))
            Save-Snapshot 'ready.png'
            $S.WantShortcut = $false
            foreach ($it in $S.Items) { $it.Want = [bool]$it.Latest }
            Start-Install
        }
    }
}

function Start-Install {
    $todo = @($S.Items | Where-Object { $_.Want -and $_.Latest })
    if (-not $todo.Count -or -not $S.Wow) { return }
    foreach ($it in $todo) { $it.Error = $null }
    # The first addon counts as in flight from the first frame, so the list and the bar never show a vague in-between state.
    $S.Phase = 'installing'; $S.Current = $todo[0].Name; $S.Todo = $todo; $S.BarAt = -1; $S.Ticks = 0
    $S.Sync = [hashtable]::Synchronized(@{ Done = 0; Current = '' })
    $Bar.BeginAnimation([System.Windows.Controls.Primitives.RangeBase]::ValueProperty, $null)
    $Bar.Foreground = $window.FindResource('Gold')
    $Bar.Maximum = $todo.Count; $Bar.Value = 0
    $Cast.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $null); $Cast.Opacity = 1
    $CastText.Text = $todo[0].Title; $CastShadow.Text = $CastText.Text
    $StatusText.Text = ''
    foreach ($it in $S.Items) { Show-Row $it }
    Show-Footer
    $spark = Get-Spark
    if ($spark) { $spark.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $null); $spark.Opacity = 1 }
    Show-RowInView $todo[0].Name
    $S.After = { param($result, $err) Complete-Install $err }
    # Test hook: a snapshot run of a long list also pauses three quarters of the way down, for a picture there.
    $S.Late = $(if ($env:FOREVER_SNAPSHOT -and $todo.Count -gt 6) { $todo[[int][Math]::Floor($todo.Count * 0.75)].Name } else { '' })
    $S.LateTicks = 0
    $S.Work = Start-Work $InstallScript @{ Todo = $todo; Wow = $S.Wow; Sync = $S.Sync; Hold = [bool]$env:FOREVER_SNAPSHOT; HoldLate = $S.Late }
    Show-InstallProgress
}

function Show-InstallProgress {
    if ($env:FOREVER_SNAPSHOT) {
        $S.Ticks = [int]$S.Ticks + 1
        if ($S.Ticks -eq 12) { try { Save-Snapshot 'installing.png' } catch { } }
        if ($S.Late -and $S.Current -eq $S.Late) {
            $S.LateTicks = [int]$S.LateTicks + 1
            if ($S.LateTicks -eq 14) { try { Save-Snapshot 'installing-late.png' } catch { } }
        }
    }
    $cur = [string]$S.Sync.Current
    if ($cur -and $cur -ne $S.Current) {
        $S.Current = $cur
        foreach ($it in $S.Todo) { Update-Status $it $S.Wow }
        foreach ($it in $S.Items) { Show-Row $it }
        $CastText.Text = $S.ByName[$cur].Title; $CastShadow.Text = $CastText.Text
        Show-RowInView $cur
    }
    # Glide the bar to "this many done, plus most of the one in flight".
    $target = [Math]::Min($S.Todo.Count, [double]$S.Sync.Done + 0.8)
    if ($target -ne $S.BarAt) { $S.BarAt = $target; Start-Glide $Bar $target 700 }
}

# The cast finishes like a spell: the bar fills, flashes green, then fades to the result.
function Complete-Install([string]$err) {
    $S.Phase = 'finishing'; $S.Current = ''
    foreach ($it in $S.Items) { Update-Status $it $S.Wow }
    $failed = @($S.Todo | Where-Object { $_.Error })
    $done = @($S.Todo | Where-Object { -not $_.Error })
    if ($done.Count -and $S.WantShortcut -and $S.OfferShortcut) {
        try { Install-Shortcut $S.Wow; $S.OfferShortcut = $false } catch { }
    }
    # The first install turns updates on (unless the tick was taken off), and a later one refreshes the task's copy.
    if ($done.Count -and $S.WantAuto) { Save-AutoUpdate $true }
    foreach ($it in $S.Items) { $it.Want = [bool]$it.Error }
    $S.Touched = $true
    foreach ($it in $S.Items) { Show-Row $it }
    $S.Result = $(
        if ($err) { @("Something went wrong: $err", $Red) }
        elseif ($failed.Count) { @("$(($failed | ForEach-Object { $_.Title }) -join ', ') didn't install. Try again.", $Red) }
        elseif (Test-WowRunning $S.Wow) { @('Done. Type /reload in game.', $Green) }
        else { @('Done. Your addons are ready.', $Green) }
    )
    $S.CastOk = (-not $err -and -not $failed.Count)
    if ($failed.Count) { Show-RowInView $failed[0].Name } else { Start-Scroll 0 }
    Start-Glide $Bar $Bar.Maximum 180
    Show-Footer
    Start-Later 200 {
        $spark = Get-Spark
        if ($spark) { Start-Fade $spark 0.0 150 }
        if ($S.CastOk) { $Bar.Foreground = $window.FindResource('Green'); $CastText.Text = 'Complete' } else { $CastText.Text = 'Failed' }
        $CastShadow.Text = $CastText.Text
        Start-Later 420 {
            Start-Fade $Cast 0.0 180
            Start-Later 190 {
                $S.Phase = 'ready'
                foreach ($it in $S.Items) { Show-Row $it }
                Set-Status $S.Result[0] $S.Result[1]
                Add-Timing 'install finished' -Save
                if ($env:FOREVER_SNAPSHOT) { Start-Later 500 { Save-Snapshot 'done.png'; $window.Close() } }
            }
        }
    }
}

# ---- go

try {
    $S.OfferShortcut = -not (Test-Path -LiteralPath (Get-ShortcutPath)); $S.WantShortcut = $true; $S.ShortOn = $false
    # Updates are on unless someone took the tick off. Someone who already has addons from an earlier installer gets
    # the task as soon as this one opens; someone new gets it with their first install.
    $S.AutoSetting = Get-AutoSetting
    $S.WantAuto = ($S.AutoSetting -ne 'off'); $S.AutoOn = $false
    if ($S.WantAuto -and $S.AutoSetting -ne 'on' -and $S.Wow -and @($S.Items | Where-Object { $_.Installed }).Count) { Save-AutoUpdate $true }
    $window = [Windows.Markup.XamlReader]::Parse($WindowXaml)
    Add-Timing 'window parsed'
    foreach ($n in 'Rock', 'DragZone', 'Plaque', 'FolderText', 'FolderShadow', 'ChangeButton', 'CloseX', 'RowsScroll', 'RowsPanel', 'MoreAbove', 'MoreBelow', 'ShortcutRow', 'ShortTick', 'AutoRow', 'AutoTick',
        'StatusRow', 'StatusText', 'StatusShadow', 'Cast', 'Bar', 'CastText', 'CastShadow', 'Go', 'CloseButton2') {
        Set-Variable -Name $n -Value $window.FindName($n)
    }
    try { $Rock.Background = New-RockBrush } catch { }
    # The list grows to show every addon and only scrolls when the screen is too short for them.
    # 290 = the rest of the window (224) plus some room above and below it.
    $S.Area = Get-ScreenArea
    $S.ListMax = [Math]::Max(180, $S.Area.Height - 290)
    $RowsScroll.MaxHeight = $S.ListMax
    if ($S.Shared.Icon) { $window.Icon = $S.Shared.Icon; $S.IconSet = $true }
    if ($env:FOREVER_SNAPSHOT) {
        # Far off-screen, out of the taskbar, never focused: a test run must not show up on anyone's desktop.
        $window.WindowStartupLocation = 'Manual'; $window.Left = -30000; $window.Top = -30000
        $window.ShowInTaskbar = $false; $window.ShowActivated = $false
    }
    Add-Timing 'stone tile'

    Set-Wants
    Show-Rows
    Show-Folder
    Show-Idle
    Add-Timing 'rows built'

    foreach ($grip in $DragZone, $Plaque) { $grip.Add_MouseLeftButtonDown({ try { $window.DragMove() } catch { } }) }
    $CloseX.Add_Click({ $window.Close() })
    $CloseButton2.Add_Click({ $window.Close() })
    $window.Add_KeyDown({ param($sender, $e) if ($e.Key -eq 'Escape') { $window.Close() } })
    # Closing fades out first; an install in flight is never cut off.
    $window.Add_Closing({
        param($sender, $e)
        if ($S.Closing) { return }
        if ($S.Phase -eq 'installing' -or $S.Phase -eq 'finishing') { $e.Cancel = $true; return }
        $e.Cancel = $true
        $S.Closing = $true
        Start-Fade $window 0.0 90
        Start-Later 100 { $window.Close() }
    })

    $ShortcutRow.Add_MouseLeftButtonDown({ $S.WantShortcut = -not $S.WantShortcut; Show-Footer })
    # Taking the tick off removes the task at once. Putting it back sets it up at once if there is anything to keep
    # current; otherwise the next install does.
    $AutoRow.Add_MouseLeftButtonDown({
        if ($S.Phase -eq 'installing' -or $S.Phase -eq 'finishing') { return }
        $S.WantAuto = -not $S.WantAuto
        if (-not $S.WantAuto) { Save-AutoUpdate $false }
        elseif (@($S.Items | Where-Object { $_.Installed }).Count) { Save-AutoUpdate $true }
        Show-Footer
    })
    $RowsScroll.Add_ScrollChanged({ try { Show-ScrollHints } catch { } })
    $window.Add_SizeChanged({ Set-OnScreen })

    $ChangeButton.Add_Click({
        if ($S.Phase -eq 'installing' -or $S.Phase -eq 'finishing') { return }
        try {
            $picked = Select-Folder $S.Wow
            if (-not $picked) { return }
            $p = Resolve-Pick $picked
            if (-not $p) { Set-Status "That folder has no $Flavor folder in it." $Red; return }
            $S.Wow = $p
            Save-WowPath $p
            Show-Folder
            foreach ($it in $S.Items) { Update-Status $it $S.Wow }
            $S.Touched = $false
            Set-Wants
            Show-Idle
        } catch { Show-Error $_.Exception.Message }
    })

    $Go.Add_Click({ try { if ($S.Phase -eq 'ready') { Start-Install } } catch { Show-Error $_.Exception.Message } })

    $S.After = { param($result, $err) Complete-Refresh $result $err }
    $timer = New-Object System.Windows.Threading.DispatcherTimer
    $timer.Interval = [TimeSpan]::FromMilliseconds(40)
    $timer.Add_Tick({
        try {
            if (-not $S.IconSet -and $S.Shared.Icon) { $window.Icon = $S.Shared.Icon; $S.IconSet = $true }
            $w = $S.Work
            if (-not $w) { return }
            if ($w.Handle.IsCompleted) {
                $S.Work = $null
                $result = $null; $err = $null
                try { $result = $w.PS.EndInvoke($w.Handle) } catch { $err = Get-ErrorText $_ }
                if (-not $err -and $w.PS.Streams.Error.Count) { $err = [string]$w.PS.Streams.Error[0] }
                $w.PS.Dispose(); $w.RS.Dispose()
                & $S.After $result $err
            } elseif ($S.Phase -eq 'installing') { Show-InstallProgress }
        } catch {
            $timer.Stop()
            Show-Error $_.Exception.Message
            if ($env:FOREVER_SNAPSHOT) { $S.Phase = 'ready'; $S.Closing = $true; $window.Close() }
        }
    })

    $window.Add_Loaded({
        Add-Timing 'window loaded'
        # A snapshot run sits in the middle of its pretend screen, the way the real window sits in the middle of the real one.
        if ($env:FOREVER_SNAPSHOT) { $window.Top = $S.Area.Top + [Math]::Max(0, ($S.Area.Height - $window.ActualHeight) / 2) }
        $S.Shown = $true
        $timer.Start(); Start-Fade $window 1.0 110
    })
    $window.Add_ContentRendered({
        Add-Timing 'window on screen' -Save
        # Only says "checking" if GitHub is slow enough for anyone to wonder.
        Start-Later 600 { if ($S.Phase -eq 'loading' -and $S.Wow) { Set-Status "Checking for updates$Ellipsis" '#C8C8C8' } }
    })

    [void]$window.ShowDialog()
} catch {
    Show-Error ("The installer hit a problem: " + $_.Exception.Message)
    exit 1
}
exit 0
