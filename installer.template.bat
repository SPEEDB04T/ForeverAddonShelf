<# :
@echo off
setlocal
set "FOREVER_SELF=%~f0"
if defined FOREVER_SELECT (
  powershell -NoProfile -ExecutionPolicy Bypass -Command "& ([scriptblock]::Create([IO.File]::ReadAllText($env:FOREVER_SELF)))"
) else (
  start "" /min powershell -NoProfile -NoLogo -ExecutionPolicy Bypass -WindowStyle Hidden -Command "& ([scriptblock]::Create([IO.File]::ReadAllText($env:FOREVER_SELF)))"
)
exit /b %ERRORLEVEL%
#>
# Forever Addon Installer for Windows: pick which shelf addons to install or update in WoW Forever.
# The lines above are a batch launcher; everything below runs in Windows PowerShell 5.1+.
# Generated by addon-hub/build.ps1 from installer.template.bat; edit the template, not the copy in dist/.
#
# The addon list comes from shelf.tsv on GitHub at run time (the copy embedded below is the offline fallback),
# and each addon's latest version from its GitHub releases, so new addons and versions show up without a new installer.
# The last answer is cached, so the window opens with the list already filled in and refreshes in the background.
#
# Test hooks: FOREVER_WOW=<folder> skips the search. FOREVER_SELECT=all|Name,Name runs without a window and prints
# to the console. FOREVER_SNAPSHOT=<dir> runs the window off-screen, saves pictures of it (ready, installing, done) and timings, closes.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
[Net.ServicePointManager]::DefaultConnectionLimit = 24

$ShelfUrl = '__SHELF_URL__'
$ShelfPage = '__SHELF_PAGE__'
$InstallerUrl = '__INSTALLER_URL__'
# The shelf as it was when this installer was built (UTF-8 TSV, base64 so this file stays plain ASCII).
$FallbackShelf = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__SHELF_B64__'))
$Flavor = '_forever_'
$ConfigDir = Join-Path $env:LOCALAPPDATA 'ForeverAddons'
$SavedPath = Join-Path $ConfigDir 'wow-path.txt'
$CacheFile = Join-Path $ConfigDir 'shelf-cache.tsv'
$LocalCopy = Join-Path $ConfigDir 'Install-ForeverAddons.bat'
$Ua = 'ForeverAddonInstaller'
# Test hook: how long each step of starting up took, counted from when the process began.
$T0 = [Diagnostics.Process]::GetCurrentProcess().StartTime
$Marks = New-Object System.Collections.Generic.List[string]
function Add-Timing([string]$what, [switch]$Save) {
    if (-not $env:FOREVER_SNAPSHOT) { return }
    $Marks.Add(("{0,6:N0} ms  {1}" -f ([DateTime]::Now - $T0).TotalMilliseconds, $what))
    if ($Save) { [IO.File]::WriteAllLines((Join-Path $env:FOREVER_SNAPSHOT 'timings.txt'), @("start $($T0.Ticks)") + $Marks) }
}
Add-Timing 'script running'

# ---------------------------------------------------------------- finding WoW Forever

function Test-Forever([string]$p) {
    return [bool]($p -and (Test-Path -LiteralPath $p -PathType Container) -and ((Split-Path $p -Leaf) -eq $Flavor))
}

# Accepts the World of Warcraft folder, the _forever_ folder, or a folder inside it.
function Resolve-Pick([string]$p) {
    if (-not $p) { return $null }
    $p = $p.TrimEnd('\')
    while ($p) {
        if (Test-Forever $p) { return $p }
        $sub = Join-Path $p $Flavor
        if (Test-Forever $sub) { return $sub }
        $parent = Split-Path $p -Parent
        if (-not $parent -or $parent -eq $p) { break }
        $p = $parent
    }
    return $null
}

function Find-Forever {
    if ($env:FOREVER_WOW) { return Resolve-Pick $env:FOREVER_WOW }
    if (Test-Path -LiteralPath $SavedPath) {
        $p = ([IO.File]::ReadAllText($SavedPath)).Trim()
        if (Test-Forever $p) { return $p }
    }
    $candidates = New-Object System.Collections.Generic.List[string]
    foreach ($key in 'HKLM:\SOFTWARE\WOW6432Node\Blizzard Entertainment\World of Warcraft', 'HKLM:\SOFTWARE\Blizzard Entertainment\World of Warcraft') {
        try {
            $ip = (Get-ItemProperty -LiteralPath $key -ErrorAction Stop).InstallPath
            if ($ip) {
                $ip = $ip.TrimEnd('\')
                $candidates.Add((Join-Path (Split-Path $ip -Parent) $Flavor))
                $candidates.Add((Join-Path $ip $Flavor))
            }
        } catch { }
    }
    foreach ($d in [IO.DriveInfo]::GetDrives()) {
        if ($d.DriveType -ne 'Fixed' -or -not $d.IsReady) { continue }
        foreach ($rel in 'World of Warcraft', 'Program Files (x86)\World of Warcraft', 'Program Files\World of Warcraft', 'Games\World of Warcraft', 'Blizzard\World of Warcraft', 'Battle.net\World of Warcraft') {
            $candidates.Add((Join-Path (Join-Path $d.RootDirectory.FullName $rel) $Flavor))
        }
    }
    foreach ($p in $candidates) { if (Test-Forever $p) { return $p } }
    return $null
}

function Save-WowPath([string]$p) {
    if ($env:FOREVER_WOW) { return }   # a folder given for this run only
    New-Item -ItemType Directory -Force $ConfigDir | Out-Null
    [IO.File]::WriteAllText($SavedPath, $p)
}

function Test-WowRunning([string]$wow) {
    if (-not $wow) { return $false }
    foreach ($proc in Get-Process -Name 'Wow*' -ErrorAction SilentlyContinue) {
        try { if ($proc.Path -and $proc.Path.StartsWith($wow, [StringComparison]::OrdinalIgnoreCase)) { return $true } } catch { }
    }
    return $false
}

# ---------------------------------------------------------------- the shelf and versions

function New-WebClient {
    $wc = New-Object Net.WebClient
    $wc.Headers['User-Agent'] = $Ua
    $wc.Encoding = [Text.Encoding]::UTF8
    return $wc
}

function Get-ErrorText($err) {
    $e = $err.Exception
    while ($e.InnerException) { $e = $e.InnerException }
    if ($e.Message -match '\(404\)') { return "the download wasn't found on GitHub." }
    return $e.Message
}

# Lines of Name<TAB>Title<TAB>Repo<TAB>Notes, plus the last known release tag in the cache file.
function Read-Shelf([string]$text) {
    $list = @()
    foreach ($line in ($text -split "`r?`n")) {
        if (-not $line.Trim() -or $line.TrimStart().StartsWith('#')) { continue }
        $f = $line.Split("`t")
        if ($f.Count -lt 3 -or -not $f[0].Trim() -or -not $f[2].Trim()) { continue }
        $tag = $(if ($f.Count -gt 4 -and $f[4].Trim()) { $f[4].Trim() } else { $null })
        $list += [pscustomobject]@{
            Name = $f[0].Trim(); Title = $f[1].Trim(); Repo = $f[2].Trim()
            Notes = $(if ($f.Count -gt 3) { $f[3].Trim() } else { '' })
            Tag = $tag; Latest = $(if ($tag) { $tag -replace '^v', '' } else { $null })
            Fresh = $false; Installed = $null; Status = ''; Error = $null; Want = $false
        }
    }
    return $list
}

# What we knew last time (or what was built in), so there is something to show at once.
function Get-KnownShelf {
    try {
        if (Test-Path -LiteralPath $CacheFile) {
            $list = @(Read-Shelf ([IO.File]::ReadAllText($CacheFile)))
            if ($list.Count) { return $list }
        }
    } catch { }
    return @(Read-Shelf $FallbackShelf)
}

function Save-ShelfCache($items) {
    try {
        New-Item -ItemType Directory -Force $ConfigDir | Out-Null
        $lines = @($items | ForEach-Object { ($_.Name, $_.Title, $_.Repo, $_.Notes, [string]$_.Tag) -join "`t" })
        [IO.File]::WriteAllText($CacheFile, ($lines -join "`n") + "`n", (New-Object Text.UTF8Encoding($false)))
    } catch { }
}

# Asks GitHub for every repo's latest release tag at the same time. The tag is read from where
# /releases/latest redirects, which has no API rate limit.
function Start-TagJobs($items) {
    return @(foreach ($it in $items) {
        try {
            $req = [Net.HttpWebRequest]::Create("https://github.com/$($it.Repo)/releases/latest")
            $req.Method = 'HEAD'; $req.AllowAutoRedirect = $false; $req.UserAgent = $Ua
            @{ It = $it; Req = $req; Task = $req.GetResponseAsync() }
        } catch { @{ It = $it; Req = $null; Task = $null } }
    })
}

function Complete-TagJobs($jobs) {
    $deadline = [DateTime]::UtcNow.AddSeconds(12)
    foreach ($j in $jobs) {
        try {
            if (-not $j.Task) { continue }
            $left = [int][Math]::Max(1, ($deadline - [DateTime]::UtcNow).TotalMilliseconds)
            if (-not $j.Task.Wait($left)) { $j.Req.Abort(); continue }
            $res = $j.Task.Result
            try { $loc = $res.Headers['Location'] } finally { $res.Close() }
            $j.It.Fresh = $true
            if ($loc -match '/releases/tag/([^/?#]+)$') {
                $j.It.Tag = [uri]::UnescapeDataString($Matches[1]); $j.It.Latest = $j.It.Tag -replace '^v', ''
            } else { $j.It.Tag = $null; $j.It.Latest = $null }
        } catch { }
    }
}

# Refreshes the list and the versions together and returns the up-to-date list.
# $meanwhile runs while the requests are in flight.
function Update-Shelf($known, [scriptblock]$meanwhile) {
    $known = @($known)
    $shelfTask = $null
    try { $shelfTask = (New-WebClient).DownloadStringTaskAsync($ShelfUrl) } catch { }
    $jobs = @(Start-TagJobs $known)
    if ($meanwhile) { try { & $meanwhile } catch { } }
    $items = $known
    try {
        if ($shelfTask -and $shelfTask.Wait(10000)) {
            $remote = @(Read-Shelf $shelfTask.Result)
            if ($remote.Count) {
                $byKey = @{}
                foreach ($it in $known) { $byKey["$($it.Name)|$($it.Repo)"] = $it }
                $new = @()
                $items = @(foreach ($r in $remote) {
                    $k = $byKey["$($r.Name)|$($r.Repo)"]
                    if ($k) { $k.Title = $r.Title; $k.Notes = $r.Notes; $k } else { $new += $r; $r }
                })
                if ($new.Count) { $jobs += @(Start-TagJobs $new) }
            }
        }
    } catch { }
    Complete-TagJobs $jobs
    if (@($items | Where-Object { $_.Fresh }).Count) { Save-ShelfCache $items }
    return $items
}

function Get-InstalledVersion([string]$wow, [string]$name) {
    if (-not $wow) { return $null }
    $toc = Join-Path $wow "Interface\AddOns\$name\$name.toc"
    if (-not (Test-Path -LiteralPath $toc)) { return $null }
    foreach ($line in [IO.File]::ReadAllLines($toc)) {
        if ($line -match '^##\s*Version:\s*(.+)$') { return $Matches[1].Trim() }
    }
    return '?'
}

function Compare-Version([string]$a, [string]$b) {
    $pa = @($a -split '[.\-]' | ForEach-Object { $n = 0; [void][int]::TryParse($_, [ref]$n); $n })
    $pb = @($b -split '[.\-]' | ForEach-Object { $n = 0; [void][int]::TryParse($_, [ref]$n); $n })
    for ($i = 0; $i -lt [Math]::Max($pa.Count, $pb.Count); $i++) {
        $x = $(if ($i -lt $pa.Count) { $pa[$i] } else { 0 })
        $y = $(if ($i -lt $pb.Count) { $pb[$i] } else { 0 })
        if ($x -ne $y) { return $x - $y }
    }
    return 0
}

function Update-Status($it, [string]$wow) {
    $it.Installed = Get-InstalledVersion $wow $it.Name
    $it.Status = $(
        if ($it.Error) { 'Failed' }
        elseif (-not $it.Latest) { 'Unavailable' }
        elseif (-not $it.Installed) { 'Not installed' }
        elseif ((Compare-Version $it.Installed $it.Latest) -lt 0) { 'Update available' }
        else { 'Up to date' }
    )
}

# Installing is two halves so every download can run at once: start them all, then unpack one by one.
# The addon's folder is replaced; saved settings live in WTF\, so they're kept.
function Start-AddonDownload($it, [string]$tmp) {
    $zip = Join-Path $tmp "$($it.Name).zip"
    $wc = New-WebClient
    $url = "https://github.com/$($it.Repo)/releases/download/$($it.Tag)/$($it.Name)-$($it.Latest).zip"
    return @{ It = $it; Zip = $zip; Out = (Join-Path $tmp $it.Name); Client = $wc; Task = $wc.DownloadFileTaskAsync($url, $zip) }
}

function Complete-AddonInstall($job, [string]$wow) {
    if (-not $job.Task.Wait(120000)) { $job.Client.CancelAsync(); throw 'the download timed out.' }
    $addonsDir = Join-Path $wow 'Interface\AddOns'
    New-Item -ItemType Directory -Force $addonsDir | Out-Null
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    [IO.Compression.ZipFile]::ExtractToDirectory($job.Zip, $job.Out)
    $folders = @(Get-ChildItem -LiteralPath $job.Out -Directory)
    if (-not $folders) { throw 'the download has no addon folder in it.' }
    foreach ($f in $folders) {
        $dest = Join-Path $addonsDir $f.Name
        if (Test-Path -LiteralPath $dest) { Remove-Item -LiteralPath $dest -Recurse -Force }
        Copy-Item -LiteralPath $f.FullName -Destination $addonsDir -Recurse -Force
    }
}

function New-TempDir {
    $tmp = Join-Path $env:TEMP ('ForeverAddons-' + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory $tmp | Out-Null
    return $tmp
}

# ---------------------------------------------------------------- desktop shortcut

function Get-ShortcutPath { return (Join-Path ([Environment]::GetFolderPath('Desktop')) 'WoW Forever Addons.lnk') }

# Keeps a copy of this installer in %LOCALAPPDATA%\ForeverAddons and points a desktop shortcut at it.
function Install-Shortcut([string]$wow) {
    New-Item -ItemType Directory -Force $ConfigDir | Out-Null
    if ($env:FOREVER_SELF -and -not [string]::Equals($env:FOREVER_SELF, $LocalCopy, [StringComparison]::OrdinalIgnoreCase)) {
        Copy-Item -LiteralPath $env:FOREVER_SELF -Destination $LocalCopy -Force
    }
    $shell = New-Object -ComObject WScript.Shell
    $s = $shell.CreateShortcut((Get-ShortcutPath))
    $s.TargetPath = $LocalCopy
    $s.WorkingDirectory = $ConfigDir
    $s.Description = 'Install or update your WoW Forever addons'
    $s.WindowStyle = 7
    $exe = Get-ChildItem -LiteralPath $wow -Filter 'Wow*.exe' -File -ErrorAction SilentlyContinue | Select-Object -First 1
    $s.IconLocation = $(if ($exe) { "$($exe.FullName),0" } else { "$env:SystemRoot\System32\shell32.dll,43" })
    $s.Save()
}

# When run from the shortcut's copy, quietly fetch the newest installer for next time.
function Update-LocalCopy {
    if (-not $env:FOREVER_SELF -or -not [string]::Equals($env:FOREVER_SELF, $LocalCopy, [StringComparison]::OrdinalIgnoreCase)) { return }
    try {
        $new = (New-WebClient).DownloadString($InstallerUrl)
        if ($new.StartsWith('<# :') -and $new -ne [IO.File]::ReadAllText($LocalCopy)) {
            [IO.File]::WriteAllText($LocalCopy, $new, (New-Object Text.UTF8Encoding($false)))
        }
    } catch { }
}

# ---------------------------------------------------------------- console mode (tests, scripting)

function Invoke-Console {
    Write-Host ''
    Write-Host 'Forever Addon Installer' -ForegroundColor Cyan
    $wow = Find-Forever
    if (-not $wow) { Write-Host "Couldn't find WoW Forever. Set FOREVER_WOW to your World of Warcraft folder." -ForegroundColor Red; exit 1 }
    Save-WowPath $wow
    Write-Host "WoW Forever folder: $wow"
    $items = @(Update-Shelf (Get-KnownShelf))
    $want = @($env:FOREVER_SELECT -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    $chosen = @($items | Where-Object { $want -contains 'all' -or $want -contains $_.Name })
    if (-not $chosen.Count) { Write-Host 'Nothing selected, so nothing was changed.' -ForegroundColor Yellow; exit 0 }
    $tmp = New-TempDir
    $failed = 0
    try {
        foreach ($it in $chosen) { Update-Status $it $wow }
        $jobs = @{}
        foreach ($it in $chosen) { if ($it.Latest) { $jobs[$it.Name] = Start-AddonDownload $it $tmp } }
        foreach ($it in $chosen) {
            $was = $it.Installed
            try {
                if (-not $it.Latest) { throw "couldn't find a release on GitHub." }
                Complete-AddonInstall $jobs[$it.Name] $wow
                $note = $(if ($was -and $was -ne $it.Latest) { " (was $was)" } elseif ($was) { ' (reinstalled)' } else { '' })
                Write-Host "  Installed $($it.Title) $($it.Latest)$note" -ForegroundColor Green
            } catch {
                $failed++
                Write-Host "  $($it.Title) didn't install: $(Get-ErrorText $_)" -ForegroundColor Red
            }
        }
    } finally { Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue }
    if ($failed) { exit 1 }
    Write-Host 'Done.' -ForegroundColor Cyan
    exit 0
}

if ($env:FOREVER_SELECT) { Invoke-Console }

# ---------------------------------------------------------------- background work

# The stone behind the panel: a small tile made by build.ps1 (our own noise, not game art).
function New-RockBrush {
    $img = New-Object System.Windows.Media.Imaging.BitmapImage
    $img.BeginInit()
    $img.StreamSource = New-Object IO.MemoryStream -ArgumentList (, [Convert]::FromBase64String('__ROCK_B64__'))
    $img.CacheOption = 'OnLoad'
    $img.EndInit(); $img.Freeze()
    $tile = New-Object System.Windows.Media.ImageBrush -ArgumentList $img
    $tile.TileMode = 'Tile'; $tile.ViewportUnits = 'Absolute'
    $tile.Viewport = New-Object System.Windows.Rect -ArgumentList 0, 0, $img.PixelWidth, $img.PixelHeight
    $tile.Freeze()
    return $tile
}

# The game's own icon, read from the person's install, for the taskbar.
function Get-WowIcon([string]$wow) {
    $exe = Get-ChildItem -LiteralPath $wow -Filter 'Wow*.exe' -File -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $exe) { return $null }
    Add-Type -AssemblyName System.Drawing
    $ico = [System.Drawing.Icon]::ExtractAssociatedIcon($exe.FullName)
    $bmp = $ico.ToBitmap()
    $ms = New-Object IO.MemoryStream
    $bmp.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png)
    $bmp.Dispose(); $ico.Dispose()
    $ms.Position = 0
    $img = New-Object System.Windows.Media.Imaging.BitmapImage
    $img.BeginInit(); $img.StreamSource = $ms; $img.CacheOption = 'OnLoad'; $img.EndInit(); $img.Freeze()
    return $img
}

# The network runs on its own thread so the window never waits for it.
$WorkerInit = (@('Test-Forever', 'New-WebClient', 'Get-ErrorText', 'Read-Shelf', 'Save-ShelfCache', 'Start-TagJobs', 'Complete-TagJobs', 'Update-Shelf',
        'Start-AddonDownload', 'Complete-AddonInstall', 'New-TempDir', 'Update-LocalCopy', 'New-RockBrush', 'Get-WowIcon') |
    ForEach-Object { "function $_ {`n$((Get-Command $_).Definition)`n}" }) -join "`n"

function Start-Work([string]$script, [hashtable]$vars) {
    # A lean runspace (core commands only; the rest load when first used) opens several times faster.
    $rs = [runspacefactory]::CreateRunspace([initialsessionstate]::CreateDefault2())
    $rs.ApartmentState = 'STA'
    $rs.Open()
    foreach ($n in 'ShelfUrl', 'Flavor', 'Ua', 'InstallerUrl', 'LocalCopy', 'ConfigDir', 'CacheFile') { $rs.SessionStateProxy.SetVariable($n, (Get-Variable $n -ValueOnly)) }
    foreach ($k in $vars.Keys) { $rs.SessionStateProxy.SetVariable($k, $vars[$k]) }
    $ps = [powershell]::Create()
    $ps.Runspace = $rs
    [void]$ps.AddScript("`$ErrorActionPreference = 'Stop'`n`$ProgressPreference = 'SilentlyContinue'`n$WorkerInit`n$script")
    return @{ PS = $ps; RS = $rs; Handle = $ps.BeginInvoke() }
}

# While GitHub answers, this thread also gets the window toolkit warmed up (loading it, reading the layout,
# measuring the text) and fetches the taskbar icon, so the main thread finds all of that already done.
$RefreshScript = @'
Update-Shelf $Known {
    Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase, System.Xaml
    $w = [Windows.Markup.XamlReader]::Parse($WindowXaml)
    if ($Wow) { try { $Shared.Icon = Get-WowIcon $Wow } catch { } }
    $row = [Windows.Markup.XamlReader]::Parse($RowXaml)
    [void]$w.FindName('RowsPanel').Children.Add($row)
    $w.FindName('Rock').Background = New-RockBrush
    $root = $w.Content
    $root.Measure((New-Object System.Windows.Size -ArgumentList 640, 2000))
    $root.Arrange((New-Object System.Windows.Rect -ArgumentList 0, 0, 640, $root.DesiredSize.Height))
}
'@

# $Hold (snapshot test only) keeps the first addon in flight long enough to photograph the progress bar.
$InstallScript = @'
$tmp = New-TempDir
try {
    $jobs = @(foreach ($it in $Todo) { Start-AddonDownload $it $tmp })
    foreach ($j in $jobs) {
        $Sync.Current = $j.It.Name
        if ($Hold) { Start-Sleep -Milliseconds 700; $Hold = $false }
        try { Complete-AddonInstall $j $Wow } catch { $j.It.Error = Get-ErrorText $_ }
        $Sync.Done = $Sync.Done + 1
    }
} finally { Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue }
'@

